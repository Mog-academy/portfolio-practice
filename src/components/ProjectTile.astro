---
import type { Project } from "../data/projects";
import Media from "./Media.astro";

interface Props {
  project: Project;
  class?: string;
  imageHeight?: string;
}

const {
  project,
  class: className = "",
  imageHeight = "h-[400px] md:h-[500px]",
} = Astro.props;

const inverted = project.invertTile;
---

<a
  href={`/projects/${project.slug}`}
  class:list={[
    "group flex flex-col gap-4 border border-tertiary p-6 transition-colors duration-300",
    inverted
      ? "bg-primary hover:bg-tertiary"
      : "bg-surface-container-lowest hover:bg-surface-container-low",
    className,
  ]}
>
  <div
    class:list={[
      "w-full overflow-hidden bg-surface-variant",
      imageHeight,
    ]}
  >
    <Media
      src={project.cover}
      alt={project.title}
      type={project.coverType}
      class:list={[
        "opacity-80 group-hover:opacity-100 group-hover:scale-105",
        !inverted && "mix-blend-multiply",
      ]}
    />
  </div>
  <div
    class:list={[
      "flex justify-between items-start pt-4 border-t",
      inverted ? "border-on-primary" : "border-tertiary",
    ]}
  >
    <div class="flex flex-col gap-2">
      <h2
        class:list={[
          "text-headline-md uppercase",
          inverted ? "text-on-primary" : "text-on-surface",
        ]}
      >
        {project.title}
      </h2>
      <span
        class:list={[
          "text-label-mono",
          inverted ? "text-on-primary/70" : "text-on-surface-variant",
        ]}
      >
        {project.category} / {project.location}
      </span>
    </div>
    <span
      class:list={[
        "text-label-caps uppercase border px-3 py-1",
        inverted
          ? "text-on-primary border-on-primary"
          : "text-on-surface border-tertiary",
      ]}
    >
      {project.year}
    </span>
  </div>
</a>
