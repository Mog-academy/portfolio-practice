---
import { withBase } from "../lib/paths";

interface Props {
  src: string;
  alt: string;
  class?: string;
  type?: "image" | "video";
}

const { src, alt, class: className = "", type = "image" } = Astro.props;
const resolvedSrc = src.startsWith("http") ? src : withBase(src);
---

{
  type === "video" ? (
    <video
      class:list={["photo-treatment w-full h-full object-cover", className]}
      src={resolvedSrc}
      muted
      playsinline
      loop
      autoplay
      aria-label={alt}
    />
  ) : (
    <img
      class:list={["photo-treatment w-full h-full object-cover", className]}
      src={resolvedSrc}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  )
}
