---
import BaseLayout from "../layouts/BaseLayout.astro";
import Media from "../components/Media.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
import { withBase } from "../lib/paths";

const skooni = projects.find((p) => p.slug === "skooni")!;
const fortune = projects.find((p) => p.slug === "fortune-bay-residences")!;
const day = skooni.gallery.find((g) => g.id === "day")?.images ?? [];
const evening = skooni.gallery.find((g) => g.id === "evening")?.images ?? [];
const night = skooni.gallery.find((g) => g.id === "night")?.images ?? [];
---

<BaseLayout
  activePath="/gallery"
  title={`Gallery — ${site.name}`}
  description={site.galleryIntro}
>
  <div class="flex flex-col w-full bg-surface">
    <section class="w-full px-frame py-20 border-b border-primary">
      <div class="max-w-4xl">
        <h1 class="text-headline-lg text-primary uppercase tracking-tighter mb-8">
          Details & Form
        </h1>
        <p class="text-lg leading-7 text-secondary max-w-2xl">
          {site.galleryIntro}
        </p>
      </div>
    </section>

    <section class="w-full px-frame py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
        <div
          class="md:col-span-12 mb-12 flex justify-between items-end border-b border-tertiary pb-4"
        >
          <span class="text-label-caps text-primary tracking-widest"
            >Index / 01</span
          >
          <span class="text-label-mono text-secondary">Skooni · Day</span>
        </div>
        <div class="md:col-span-8 group relative mb-gutter md:mb-0">
          <div class="aspect-[4/3] w-full overflow-hidden bg-surface-container">
            <Media
              src={day[0]}
              alt="Skooni facade day"
              class="mix-blend-multiply group-hover:scale-105"
            />
          </div>
          <div
            class="absolute inset-0 bg-primary/0 group-hover:bg-primary/90 transition-colors duration-300 flex flex-col justify-end p-8 opacity-0 group-hover:opacity-100"
          >
            <h3
              class="text-label-caps text-on-primary mb-2 border-b border-on-primary/30 pb-2"
            >
              Technical Specs
            </h3>
            <p class="text-label-mono text-on-primary/80 mb-1">
              Condition: Daylight
            </p>
            <p class="text-label-mono text-on-primary/80 mb-1">
              Subject: Facade System
            </p>
            <p class="text-label-mono text-on-primary/80">Project: Skooni</p>
          </div>
        </div>
        <div class="md:col-span-4 flex flex-col justify-end pt-8 md:pt-0 pb-4">
          <h2 class="text-headline-md text-primary mb-4 uppercase">
            Glass & Steel Tension
          </h2>
          <p class="text-base leading-6 text-secondary mb-8">
            PLACEHOLDER: Daylight reading of the Skooni elevation — planar
            geometry, mullion rhythm, and reflected sky.
          </p>
          <a
            href={withBase(`/projects/${skooni.slug}`)}
            class="self-start px-8 py-3 bg-primary text-on-primary text-label-caps uppercase hover:bg-surface hover:text-primary border border-primary transition-colors"
          >
            View Project
          </a>
        </div>
      </div>
    </section>

    <section class="w-full px-frame py-12">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
        <div
          class="md:col-span-12 mb-12 flex justify-between items-end border-b border-tertiary pb-4"
        >
          <span class="text-label-caps text-primary tracking-widest"
            >Index / 02</span
          >
          <span class="text-label-mono text-secondary">Evening & Night</span>
        </div>
        <div class="md:col-span-4 group relative mb-gutter md:mb-0">
          <div class="aspect-[3/4] w-full overflow-hidden bg-surface-container">
            <Media
              src={evening[0]}
              alt="Skooni evening"
              class="mix-blend-multiply group-hover:scale-105"
            />
          </div>
        </div>
        <div class="md:col-span-4 group relative mb-gutter md:mb-0 pt-0 md:pt-24">
          <div class="aspect-square w-full overflow-hidden bg-surface-container">
            <Media
              src={evening[2] ?? evening[1]}
              alt="Skooni evening exterior"
              class="mix-blend-multiply group-hover:scale-105"
            />
          </div>
        </div>
        <div class="md:col-span-4 group relative pt-0 md:pt-48">
          <div class="aspect-[3/4] w-full overflow-hidden bg-surface-container">
            <Media
              src={night[0]}
              alt="Skooni night facade"
              class="mix-blend-multiply group-hover:scale-105"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="w-full px-frame py-20 mt-20 bg-primary">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
        <div class="md:col-span-6 text-on-primary">
          <h2 class="text-display-xl uppercase tracking-tighter leading-none mb-6">
            Light &<br />Shadow
          </h2>
          <p class="text-lg leading-7 text-on-primary/70 max-w-md">
            The manipulation of natural light forms the essence of spatial
            perception. Geometry creates distinct boundaries between illuminated
            surfaces and absolute darkness.
          </p>
        </div>
        <div class="md:col-span-6 mt-12 md:mt-0">
          <div
            class="aspect-[16/9] w-full overflow-hidden bg-primary-container border border-on-primary/20"
          >
            <Media
              src={fortune.cover}
              alt="Fortune Bay light study"
              class="opacity-80 mix-blend-screen"
            />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
